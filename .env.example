# .env — required by docker-compose.yml
#
# Copy this file to .env and fill in values before running: docker compose up
# .env is git-ignored and must never be committed.
#
# NOTE: This file configures the local docker-compose setup only.
# For the AWS EKS deployment, all secrets are managed by scripts/bootstrap.sh
# and stored as GitHub Actions Secrets — never in this file.

# ── SQL Server ────────────────────────────────────────────────────────────────
# Password for the SQL Server SA account.
# Used by both the db container and the backend connection string.
# Must satisfy SQL Server password complexity (upper, lower, digit, symbol, ≥8 chars).
SA_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Signing key for HS256 JWT tokens.
# Use a strong random string of at least 32 characters.
# Example (do not use this value): openssl rand -base64 48
JWT_SECRET=

# ── Admin seed accounts ───────────────────────────────────────────────────────
# Initial passwords for the two built-in admin accounts created on first startup.
#   admin@admin.com   → Admin role
#   super@admin.com   → SuperAdmin role
# Must satisfy ASP.NET Core Identity password policy (upper, lower, digit, ≥6 chars).
ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD=

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Name of the S3 bucket used for ticket image uploads.
# Required for the image upload feature to work locally.
# For local testing, you need valid AWS credentials in the environment
# and a bucket the credentials can access. In EKS, the backend uses IRSA.
AWS_BUCKET_NAME=
